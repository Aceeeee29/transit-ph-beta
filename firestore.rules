rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'superadmin';
    }

    // .get('role', '') so a user with no role field doesn't make the
    // rule fail.
    function isModerator() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'moderator';
    }

    function isStaff() {
      return isModerator() || isSuperAdmin();
    }

    function hasValidPostContent(data) {
      return data.content is string &&
        data.content.size() > 0 &&
        data.content.size() <= 500;
    }

    // Banned and restricted riders can still read, but not post, comment,
    // add routes or file reports. The app also checks. This stops a
    // modified app or a direct API call.
    function notBanned() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let until = me.get('restrictedUntil', null);
      return me.get('isBanned', false) != true &&
        me.get('status', 'active') != 'banned' &&
        !(until is timestamp && until > request.time);
    }

    // Set only by staff or the dashboard, never by the rider's own app.
    // tempSuperadmin*: the dashboard lets these accounts in.
    function staffOnlyUserKeys() {
      return ['role', 'isBanned', 'status', 'restrictedAt', 'restrictedUntil',
        'tempSuperadminUntil', 'tempSuperadminBy'];
    }

    // Users
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isSelf(uid) &&
        request.resource.data.get('role', 'user') == 'user' &&
        !request.resource.data.keys().hasAny(['tempSuperadminUntil', 'tempSuperadminBy']);
      // A rider can edit their own profile, but not their role or their
      // ban/restriction state (those belong to staff).
      allow update: if (
        isSelf(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(staffOnlyUserKeys())
      ) || isSuperAdmin() || (
        isModerator() &&
        resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isBanned', 'status', 'restrictedAt', 'restrictedUntil']) &&
        request.resource.data.get('isBanned', false) == false &&
        (
          (
            request.resource.data.get('status', 'active') == 'active' &&
            !request.resource.data.keys().hasAny(['restrictedAt']) &&
            !request.resource.data.keys().hasAny(['restrictedUntil'])
          ) ||
          (
            request.resource.data.get('status', 'active') == 'restricted' &&
            request.resource.data.get('restrictedAt', null) is timestamp &&
            request.resource.data.get('restrictedUntil', null) is timestamp &&
            request.resource.data.get('restrictedUntil', null) > request.time &&
            request.resource.data.get('restrictedUntil', null) <= request.time + duration.value(7, 'd')
          )
        )
      );
      // A rider deletes their own account (Settings → Delete account).
      allow delete: if isSelf(uid) || isSuperAdmin();

      match /achievements/{achievementId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /badges/{badgeId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /routeHistory/{historyId} {
        allow read, write: if isSelf(uid);
      }

      // Why the rider was banned or restricted, shown to them on the
      // locked-out popup. Kept here instead of on the profile because any
      // signed-in account can read profiles. The rider reads their own.
      // Only staff write it. Moderators only restrict, and only regular
      // riders, the same as on the profile above.
      match /moderation/{docId} {
        allow read: if isSelf(uid) || isStaff();
        allow write: if isSuperAdmin() || (
          isModerator() &&
          get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user') == 'user' &&
          request.resource.data.get('action', '') == 'restrict'
        );
      }
    }

    // Posts
    match /posts/{postId} {
      // Pending posts are only visible to their author.
      // The author sees every post of their own, rejected ones too (so
      // deleting their account can find them all).
      allow read: if isAuth() && (
        isStaff() ||
        resource.data.moderationStatus == 'approved' ||
        request.auth.uid == resource.data.userId
      );

      // Posted as yourself. New posts are live (approved) or waiting
      // (pending), never pre-rejected or under someone else's name.
      allow create: if isAuth() && hasValidPostContent(request.resource.data) && (
        isStaff() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.get('moderationStatus', 'approved') in ['approved', 'pending'] &&
          notBanned()
        )
      );

      // Checks on post votes.
      // Vote counters can only move by 1 per operation and voter arrays
      // are constrained to transitions involving the requesting UID.
      // The author edits the post itself but not who wrote it, its review
      // state (a rejected post stays rejected), its feed lifetime (staff
      // set that) or the vote counts (votes go through the branch below).
      allow update: if isAuth() &&
        hasValidPostContent(request.resource.data) && (
          (
            request.auth.uid == resource.data.userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'userId', 'moderationStatus', 'expiresAt',
              'upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy'
            ])
          ) ||
          isStaff() ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy']) &&
            request.resource.data.upvoteCount >= 0 &&
            request.resource.data.downvoteCount >= 0 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) >= -1 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) <= 1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) >= -1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) <= 1 &&
            (
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount &&
                request.resource.data.upvotedBy == resource.data.upvotedBy
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount + 1 &&
                request.resource.data.upvotedBy.hasAll(resource.data.upvotedBy) &&
                request.resource.data.upvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount - 1 &&
                !request.resource.data.upvotedBy.hasAny([request.auth.uid])
              )
            ) &&
            (
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount &&
                request.resource.data.downvotedBy == resource.data.downvotedBy
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount + 1 &&
                request.resource.data.downvotedBy.hasAll(resource.data.downvotedBy) &&
                request.resource.data.downvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount - 1 &&
                !request.resource.data.downvotedBy.hasAny([request.auth.uid])
              )
            )
          )
        );

      allow delete: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        isStaff()
      );

      match /comments/{commentId} {
        allow read: if isAuth();
        // Commented as yourself, on a post that exists.
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000 &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          notBanned();
        allow update: if isAuth() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isStaff()
        );
      }
    }

    // Routes
    // Routes now live in Supabase, and every write goes through the
    // routes-api server function. This old copy stays readable so older
    // app versions can still show routes until they update. Nothing may
    // write here any more, not even staff: a change made here would never
    // reach Supabase and would be lost.
    match /routes/{routeId} {
      allow read: if isAuth();
      allow write: if false;

      // Old vote, view and feedback markers. A rider can still read their
      // own, but new ones are saved in Supabase.
      match /routeVotes/{userId} {
        allow read: if isAuth() && isSelf(userId);
        allow write: if false;
      }

      match /routeViews/{userId} {
        allow read: if isAuth() && isSelf(userId);
        allow write: if false;
      }

      match /routeFeedback/{userId} {
        allow read: if isAuth() && isSelf(userId);
        allow write: if false;
      }

      // Old moderation history. The dashboard still reads it to count each
      // moderator's past approvals.
      match /auditLogs/{logId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Collection-group reads of route audit logs (the dashboard counts each
    // moderator's approvals from them). Read-only. Writes stay on the rule above.
    match /{path=**}/auditLogs/{logId} {
      allow read: if isStaff();
    }

    // Collection-group reads of post comments: finding someone's comments
    // across all posts when their account is deleted or closed. Comments
    // are readable anyway. Writes stay on the rule under posts.
    match /{path=**}/comments/{commentId} {
      allow read: if isAuth();
    }

    // Quick route links (24h token-based access)
    match /quick_route_links/{token} {
      // Token docs are never listable. Only direct token lookup is allowed.
      allow list: if false;
      allow get: if resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;

      allow create: if isAuth() &&
        request.resource.data.token == token &&
        request.resource.data.isQuickRoute == true &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.draftRoute is map;

      // Keep quick links immutable so TTL constraints cannot be extended.
      allow update: if false;
      allow delete: if isStaff() || (isAuth() && resource.data.ownerId == request.auth.uid);
    }

    // Quick routes (temporary, private-by-link)
    match /quick_routes/{quickRouteId} {
      allow list: if false;
      allow get: if resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;

      allow create: if isAuth() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.isQuickRoute == true &&
        request.resource.data.sourceToken is string &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time;

      allow update: if false;
      allow delete: if isStaff();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update: if isAuth() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      // The superadmin too: closing an account removes its notifications.
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );

      // Moderators can notify anyone, themselves too (like when they
      // approve their own route). Others can't notify themselves, so they
      // can't spam their own inbox.
      // A rider only sends the kinds the app sends, to the person they're
      // about: a vote/comment/reply goes to that post's author, a route
      // report to that route's contributor. Older app versions leave
      // fromUserId empty on votes and comments, so empty is allowed.
      allow create: if isAuth() && (
        isModerator() ||
        isSuperAdmin() ||
        (
          request.resource.data.keys().hasAll(['userId', 'type', 'timestamp']) &&
          request.resource.data.userId is string &&
          request.resource.data.userId != request.auth.uid &&
          request.resource.data.get('message', '') is string &&
          request.resource.data.get('message', '').size() <= 400 &&
          request.resource.data.get('isRead', false) == false &&
          request.resource.data.get('fromUserId', null) in [null, request.auth.uid] &&
          (
            (
              request.resource.data.type in ['upvote', 'downvote', 'comment', 'reply'] &&
              request.resource.data.get('postId', null) is string &&
              get(/databases/$(database)/documents/posts/$(request.resource.data.postId))
                .data.userId == request.resource.data.userId
            ) ||
            (
              request.resource.data.type == 'route_reported' &&
              request.resource.data.get('fromUserId', null) == request.auth.uid &&
              request.resource.data.get('routeId', null) is string
            )
          )
        )
      );
    }

    // Route reports
    // Shown on every route on the same road, so every rider reads them.
    // A rider files one as themselves, for at most a day. Only staff keep
    // one longer or remove it.
    match /route_reports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.kept == false &&
        request.resource.data.type is string &&
        request.resource.data.path is list &&
        request.resource.data.path.size() <= 300 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt < request.time + duration.value(25, 'h') &&
        notBanned();
      allow update, delete: if isStaff();
    }

    // Feedbacks (reports)
    match /feedbacks/{feedbackId} {
      allow create: if isAuth();
      // Riders can read their own feedback to see its status.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isStaff()
      );
      allow update: if isStaff();
      // The author too, when deleting their account.
      allow delete: if isStaff() || (
        isAuth() && resource.data.userId == request.auth.uid
      );
    }

    // Appeals
    // A banned or restricted rider asking staff to undo it. The id is
    // "<uid>_<lockoutId>", so each ban or restriction gets one appeal: a
    // second one for the same lockout hits the existing doc, which only
    // staff can change.
    match /appeals/{appealId} {
      // The id check lets the rider look up their own appeal before it
      // exists (to know whether to show the Appeal button).
      allow read: if isAuth() && (
        appealId.matches(request.auth.uid + '_.+') ||
        isStaff() ||
        resource.data.userId == request.auth.uid
      );
      // Only while actually locked out, as themselves, still waiting.
      allow create: if isAuth() &&
        !notBanned() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.lockoutId is string &&
        appealId == request.auth.uid + '_' + request.resource.data.lockoutId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail',
          'lockoutId', 'action', 'reasonLabel', 'note', 'message', 'status',
          'createdAt']);
      // Superadmins decide any appeal. Moderators only restriction ones
      // (they can't lift a ban), and only the decision fields.
      allow update: if isSuperAdmin() || (
        isModerator() &&
        resource.data.get('action', '') == 'restrict' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reply', 'reviewedBy', 'reviewedAt'])
      );
      // The rider too, when deleting their account.
      allow delete: if isSuperAdmin() || (
        isAuth() && resource.data.userId == request.auth.uid
      );
    }

    // Locations
    match /locations/{locationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Only the creator or staff can update or delete one.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
    }

    // Announcements (superadmin only writes)
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // App config (superadmin only writes)
    match /app_config/{configId} {
      // Allow startup update checks before authentication for this single doc.
      allow read: if configId == 'update_checker' || isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // Route cache (per-user)
    // Searches can show where someone travels: owner only. (The app keeps
    // its route cache on the phone now. Nothing reads this collection.)
    match /route_cache/{cacheId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
