rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    // FIX: Use .get('role', '') to safely handle missing role field,
    // preventing null-dereference crashes in rule evaluation.
    function isModerator() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'moderator';
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isModerator();
      allow delete: if isModerator();

      match /achievements/{achievementId} {
        allow read, write: if isSelf(uid) || isModerator();
      }

      match /badges/{badgeId} {
        allow read, write: if isSelf(uid) || isModerator();
      }

      // FIX: Added explicit rules for subcollections the app writes to.
      match /bookmarks/{bookmarkId} {
        allow read, write: if isSelf(uid);
      }

      match /routeHistory/{historyId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── POSTS ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // FIX: Pending posts are now only visible to their own author.
      allow read: if isAuth() && (
        resource.data.moderationStatus == 'approved' ||
        (resource.data.moderationStatus == 'pending' &&
          request.auth.uid == resource.data.userId)
      );

      allow create: if isAuth();

      // FIX: Added field-level validation for post votes.
      // Vote counters can only move by 1 per operation and voter arrays
      // are constrained to transitions involving the requesting UID.
      allow update: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        isModerator() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy']) &&
          request.resource.data.upvoteCount >= 0 &&
          request.resource.data.downvoteCount >= 0 &&
          (request.resource.data.upvoteCount - resource.data.upvoteCount) >= -1 &&
          (request.resource.data.upvoteCount - resource.data.upvoteCount) <= 1 &&
          (request.resource.data.downvoteCount - resource.data.downvoteCount) >= -1 &&
          (request.resource.data.downvoteCount - resource.data.downvoteCount) <= 1 &&
          (
            (
              request.resource.data.upvoteCount == resource.data.upvoteCount &&
              request.resource.data.upvotedBy == resource.data.upvotedBy
            ) ||
            (
              request.resource.data.upvoteCount == resource.data.upvoteCount + 1 &&
              request.resource.data.upvotedBy.hasAll(resource.data.upvotedBy) &&
              request.resource.data.upvotedBy.hasAll([request.auth.uid])
            ) ||
            (
              request.resource.data.upvoteCount == resource.data.upvoteCount - 1 &&
              !request.resource.data.upvotedBy.hasAny([request.auth.uid])
            )
          ) &&
          (
            (
              request.resource.data.downvoteCount == resource.data.downvoteCount &&
              request.resource.data.downvotedBy == resource.data.downvotedBy
            ) ||
            (
              request.resource.data.downvoteCount == resource.data.downvoteCount + 1 &&
              request.resource.data.downvotedBy.hasAll(resource.data.downvotedBy) &&
              request.resource.data.downvotedBy.hasAll([request.auth.uid])
            ) ||
            (
              request.resource.data.downvoteCount == resource.data.downvoteCount - 1 &&
              !request.resource.data.downvotedBy.hasAny([request.auth.uid])
            )
          )
        )
      );

      allow delete: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        isModerator()
      );

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() &&
          resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isModerator()
        );
      }
    }

    // ── ROUTES ────────────────────────────────────────────────────────────────
    match /routes/{routeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.contributorId == request.auth.uid ||
        isModerator() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'upvotes', 'downvotes', 'updatedAt']) &&
          request.resource.data.views >= 0 &&
          request.resource.data.upvotes >= 0 &&
          request.resource.data.downvotes >= 0 &&
          (request.resource.data.views - resource.data.views) >= -1 &&
          (request.resource.data.views - resource.data.views) <= 1 &&
          (request.resource.data.upvotes - resource.data.upvotes) >= -1 &&
          (request.resource.data.upvotes - resource.data.upvotes) <= 1 &&
          (request.resource.data.downvotes - resource.data.downvotes) >= -1 &&
          (request.resource.data.downvotes - resource.data.downvotes) <= 1
        )
      );
      allow delete: if isModerator();

      // Per-user vote state for one active vote at a time.
      match /routeVotes/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }

      // Per-user view markers to avoid recounting the same user repeatedly.
      match /routeViews/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isAuth() &&
        resource.data.userId == request.auth.uid;

      // FIX: Moderators can create notifications for any userId, including
      // themselves (e.g. self-approval of a submitted route). Non-moderators
      // still cannot target themselves to prevent self-spam.
      allow create: if isAuth() && (
        isModerator() ||
        (
          request.resource.data.keys().hasAll(['userId', 'type', 'timestamp']) &&
          request.resource.data.userId is string &&
          request.resource.data.userId != request.auth.uid
        )
      );
    }

    // ── FEEDBACKS (reports) ───────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow create: if isAuth();
      // FIX: Users can now read their own feedback to see its status.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isModerator()
      );
      allow update, delete: if isModerator();
    }

    // ── LOCATIONS ─────────────────────────────────────────────────────────────
    match /locations/{locationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // FIX: Restricted update/delete to creator or moderator only.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isModerator()
      );
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isModerator()
      );
    }
  }
}
