rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'superadmin';
    }

    // FIX: Use .get('role', '') to safely handle missing role field,
    // preventing null-dereference crashes in rule evaluation.
    function isModerator() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'moderator';
    }

    function isStaff() {
      return isModerator() || isSuperAdmin();
    }

    function hasValidPostContent(data) {
      return data.content is string &&
        data.content.size() > 0 &&
        data.content.size() <= 500;
    }

    // Banned and restricted riders can still read, but not post, comment,
    // add routes or file reports. The app also checks; this stops a
    // modified app or a direct API call.
    function notBanned() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let until = me.get('restrictedUntil', null);
      return me.get('isBanned', false) != true &&
        me.get('status', 'active') != 'banned' &&
        !(until is timestamp && until > request.time);
    }

    // Set only by staff or the dashboard, never by the rider's own app.
    // tempSuperadmin*: the dashboard lets these accounts in.
    function staffOnlyUserKeys() {
      return ['role', 'isBanned', 'status', 'restrictedAt', 'restrictedUntil',
        'tempSuperadminUntil', 'tempSuperadminBy'];
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isSelf(uid) &&
        request.resource.data.get('role', 'user') == 'user' &&
        !request.resource.data.keys().hasAny(['tempSuperadminUntil', 'tempSuperadminBy']);
      // A rider can edit their own profile, but not their role or their
      // ban/restriction state (those belong to staff).
      allow update: if (
        isSelf(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(staffOnlyUserKeys())
      ) || isSuperAdmin() || (
        isModerator() &&
        resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isBanned', 'status', 'restrictedAt', 'restrictedUntil']) &&
        request.resource.data.get('isBanned', false) == false &&
        (
          (
            request.resource.data.get('status', 'active') == 'active' &&
            !request.resource.data.keys().hasAny(['restrictedAt']) &&
            !request.resource.data.keys().hasAny(['restrictedUntil'])
          ) ||
          (
            request.resource.data.get('status', 'active') == 'restricted' &&
            request.resource.data.get('restrictedAt', null) is timestamp &&
            request.resource.data.get('restrictedUntil', null) is timestamp &&
            request.resource.data.get('restrictedUntil', null) > request.time &&
            request.resource.data.get('restrictedUntil', null) <= request.time + duration.value(7, 'd')
          )
        )
      );
      // A rider deletes their own account (Settings → Delete account).
      allow delete: if isSelf(uid) || isSuperAdmin();

      match /achievements/{achievementId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /badges/{badgeId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /routeHistory/{historyId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── POSTS ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // FIX: Pending posts are now only visible to their own author.
      // The author sees every post of their own, rejected ones too (so
      // deleting their account can find them all).
      allow read: if isAuth() && (
        isStaff() ||
        resource.data.moderationStatus == 'approved' ||
        request.auth.uid == resource.data.userId
      );

      // Posted as yourself; new posts are live (approved) or waiting
      // (pending), never pre-rejected or under someone else's name.
      allow create: if isAuth() && hasValidPostContent(request.resource.data) && (
        isStaff() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.get('moderationStatus', 'approved') in ['approved', 'pending'] &&
          notBanned()
        )
      );

      // FIX: Added field-level validation for post votes.
      // Vote counters can only move by 1 per operation and voter arrays
      // are constrained to transitions involving the requesting UID.
      // The author edits the post itself but not who wrote it, its review
      // state (a rejected post stays rejected), its feed lifetime (staff
      // set that) or the vote counts (votes go through the branch below).
      allow update: if isAuth() &&
        hasValidPostContent(request.resource.data) && (
          (
            request.auth.uid == resource.data.userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'userId', 'moderationStatus', 'expiresAt',
              'upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy'
            ])
          ) ||
          isStaff() ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy']) &&
            request.resource.data.upvoteCount >= 0 &&
            request.resource.data.downvoteCount >= 0 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) >= -1 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) <= 1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) >= -1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) <= 1 &&
            (
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount &&
                request.resource.data.upvotedBy == resource.data.upvotedBy
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount + 1 &&
                request.resource.data.upvotedBy.hasAll(resource.data.upvotedBy) &&
                request.resource.data.upvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount - 1 &&
                !request.resource.data.upvotedBy.hasAny([request.auth.uid])
              )
            ) &&
            (
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount &&
                request.resource.data.downvotedBy == resource.data.downvotedBy
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount + 1 &&
                request.resource.data.downvotedBy.hasAll(resource.data.downvotedBy) &&
                request.resource.data.downvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount - 1 &&
                !request.resource.data.downvotedBy.hasAny([request.auth.uid])
              )
            )
          )
        );

      allow delete: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        isStaff()
      );

      match /comments/{commentId} {
        allow read: if isAuth();
        // Commented as yourself, on a post that exists.
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000 &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          notBanned();
        allow update: if isAuth() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isStaff()
        );
      }
    }

    // ── ROUTES ────────────────────────────────────────────────────────────────
    // One rider's feedback (routeFeedback, saved in the same transaction)
    // moves each yes/no pair by exactly one.
    function feedbackPairStep(before, after, yes, no) {
      let dYes = after.get(yes, 0) - before.get(yes, 0);
      let dNo = after.get(no, 0) - before.get(no, 0);
      return dYes >= 0 && dNo >= 0 && dYes + dNo == 1;
    }

    function isFeedbackSummaryStep(routeId) {
      let before = resource.data.get('feedbackSummary', {});
      let after = request.resource.data.feedbackSummary;
      let feedbackPath = /databases/$(database)/documents/routes/$(routeId)/routeFeedback/$(request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['feedbackSummary', 'updatedAt']) &&
        after is map &&
        after.keys().hasOnly([
          'fareAccurateYes', 'fareAccurateNo',
          'scheduleAccurateYes', 'scheduleAccurateNo',
          'stillOperatingYes', 'stillOperatingNo',
          'lastFeedbackAt'
        ]) &&
        existsAfter(feedbackPath) &&
        getAfter(feedbackPath).data.updatedAt == request.time &&
        feedbackPairStep(before, after, 'fareAccurateYes', 'fareAccurateNo') &&
        feedbackPairStep(before, after, 'scheduleAccurateYes', 'scheduleAccurateNo') &&
        feedbackPairStep(before, after, 'stillOperatingYes', 'stillOperatingNo');
    }

    match /routes/{routeId} {
      allow read: if isAuth();
      // Riders add routes as themselves, waiting for review; only staff
      // add one that's already approved.
      allow create: if isAuth() && (
        isStaff() || (
          request.resource.data.contributorId == request.auth.uid &&
          request.resource.data.approvalStatus == 'pending' &&
          notBanned()
        )
      );
      // The contributor may edit their route, but an edit goes back to
      // review: they can't approve it or hand it to someone else.
      allow update: if isAuth() && (
        (
          resource.data.contributorId == request.auth.uid &&
          request.resource.data.contributorId == request.auth.uid &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus']) ||
            request.resource.data.approvalStatus == 'pending'
          )
        ) ||
        isStaff() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'upvotes', 'downvotes', 'updatedAt']) &&
          request.resource.data.views >= 0 &&
          request.resource.data.upvotes >= 0 &&
          request.resource.data.downvotes >= 0 &&
          (request.resource.data.views - resource.data.views) >= -1 &&
          (request.resource.data.views - resource.data.views) <= 1 &&
          (request.resource.data.upvotes - resource.data.upvotes) >= -1 &&
          (request.resource.data.upvotes - resource.data.upvotes) <= 1 &&
          (request.resource.data.downvotes - resource.data.downvotes) >= -1 &&
          (request.resource.data.downvotes - resource.data.downvotes) <= 1
        ) ||
        isFeedbackSummaryStep(routeId) ||
        // Closing their account: the contributor hands the route over as
        // "Former rider" (only these fields; it stays for everyone).
        (
          resource.data.contributorId == request.auth.uid &&
          request.resource.data.get('contributorId', null) == null &&
          request.resource.data.get('contributorName', '') == 'Former rider' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contributorId', 'contributorName', 'contributorClosed', 'updatedAt'])
        )
      );
      // Staff, or a contributor removing their own route that isn't live
      // yet (deleting their account).
      allow delete: if isStaff() || (
        isAuth() &&
        resource.data.contributorId == request.auth.uid &&
        resource.data.get('approvalStatus', 'pending') != 'approved'
      );

      // Per-user vote state for one active vote at a time.
      match /routeVotes/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }

      // Per-user view markers to avoid recounting the same user repeatedly.
      match /routeViews/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }

      // Per-user trust feedback answers for route reliability.
      match /routeFeedback/{userId} {
        allow read: if isAuth() && isSelf(userId);
        allow create: if isAuth() &&
          isSelf(userId) &&
          request.resource.data.keys().hasOnly([
            'routeId',
            'userId',
            'fareAccurate',
            'scheduleAccurate',
            'stillOperating',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.routeId == routeId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.fareAccurate is bool &&
          request.resource.data.scheduleAccurate is bool &&
          request.resource.data.stillOperating is bool &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
        allow update: if isAuth() &&
          isSelf(userId) &&
          request.resource.data.keys().hasOnly([
            'routeId',
            'userId',
            'fareAccurate',
            'scheduleAccurate',
            'stillOperating',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.routeId == resource.data.routeId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.fareAccurate is bool &&
          request.resource.data.scheduleAccurate is bool &&
          request.resource.data.stillOperating is bool &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt is timestamp &&
          (
            (resource.data.updatedAt is timestamp &&
              resource.data.updatedAt + duration.value(30, 'd') <= request.time) ||
            (resource.data.createdAt is timestamp &&
              resource.data.createdAt + duration.value(30, 'd') <= request.time)
          );
        allow delete: if false;
      }

      // Route audit logs are visible to staff; regular users can only write
      // self-authored commuter feedback log entries.
      match /auditLogs/{logId} {
        allow read: if isStaff();
        allow create: if isAuth() && (
          isStaff() ||
          (
            request.resource.data.action == 'commuter_feedback_submitted' &&
            request.resource.data.actorId == request.auth.uid
          )
        );
        allow update, delete: if isStaff();
      }
    }

    // Collection-group reads of route audit logs (the dashboard counts each
    // moderator's approvals from them). Read-only; writes stay on the rule above.
    match /{path=**}/auditLogs/{logId} {
      allow read: if isStaff();
    }

    // Collection-group reads of post comments: finding someone's comments
    // across all posts when their account is deleted or closed. Comments
    // are readable anyway; writes stay on the rule under posts.
    match /{path=**}/comments/{commentId} {
      allow read: if isAuth();
    }

    // ── QUICK ROUTE LINKS (24h token-based access) ─────────────────────────
    match /quick_route_links/{token} {
      // Token docs are never listable; only direct token lookup is allowed.
      allow list: if false;
      allow get: if resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;

      allow create: if isAuth() &&
        request.resource.data.token == token &&
        request.resource.data.isQuickRoute == true &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.draftRoute is map;

      // Keep quick links immutable so TTL constraints cannot be extended.
      allow update: if false;
      allow delete: if isStaff() || (isAuth() && resource.data.ownerId == request.auth.uid);
    }

    // ── QUICK ROUTES (temporary, private-by-link) ─────────────────────────
    match /quick_routes/{quickRouteId} {
      allow list: if false;
      allow get: if resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;

      allow create: if isAuth() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.isQuickRoute == true &&
        request.resource.data.sourceToken is string &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time;

      allow update: if false;
      allow delete: if isStaff();
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isAuth() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      // The superadmin too: closing an account removes its notifications.
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );

      // FIX: Moderators can create notifications for any userId, including
      // themselves (e.g. self-approval of a submitted route). Non-moderators
      // still cannot target themselves to prevent self-spam.
      // A rider only sends the kinds the app sends, to the person they're
      // about: a vote/comment/reply goes to that post's author, a route
      // report to that route's contributor. Older app versions leave
      // fromUserId empty on votes and comments, so empty is allowed.
      allow create: if isAuth() && (
        isModerator() ||
        isSuperAdmin() ||
        (
          request.resource.data.keys().hasAll(['userId', 'type', 'timestamp']) &&
          request.resource.data.userId is string &&
          request.resource.data.userId != request.auth.uid &&
          request.resource.data.get('message', '') is string &&
          request.resource.data.get('message', '').size() <= 400 &&
          request.resource.data.get('isRead', false) == false &&
          request.resource.data.get('fromUserId', null) in [null, request.auth.uid] &&
          (
            (
              request.resource.data.type in ['upvote', 'downvote', 'comment', 'reply'] &&
              request.resource.data.get('postId', null) is string &&
              get(/databases/$(database)/documents/posts/$(request.resource.data.postId))
                .data.userId == request.resource.data.userId
            ) ||
            (
              request.resource.data.type == 'route_reported' &&
              request.resource.data.get('fromUserId', null) == request.auth.uid &&
              request.resource.data.get('routeId', null) is string &&
              get(/databases/$(database)/documents/routes/$(request.resource.data.routeId))
                .data.get('contributorId', '') == request.resource.data.userId
            )
          )
        )
      );
    }

    // ── ROUTE REPORTS ─────────────────────────────────────────────────────────
    // Shown on every route on the same road, so every rider reads them.
    // A rider files one as themselves, for at most a day; only staff keep
    // one longer or remove it.
    match /route_reports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.kept == false &&
        request.resource.data.type is string &&
        request.resource.data.path is list &&
        request.resource.data.path.size() <= 300 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt < request.time + duration.value(25, 'h') &&
        notBanned();
      allow update, delete: if isStaff();
    }

    // ── FEEDBACKS (reports) ───────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow create: if isAuth();
      // FIX: Users can now read their own feedback to see its status.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isStaff()
      );
      allow update: if isStaff();
      // The author too, when deleting their account.
      allow delete: if isStaff() || (
        isAuth() && resource.data.userId == request.auth.uid
      );
    }

    // ── LOCATIONS ─────────────────────────────────────────────────────────────
    match /locations/{locationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // FIX: Restricted update/delete to creator or moderator only.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
    }

    // ── ANNOUNCEMENTS (superadmin only writes) ──────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── APP CONFIG (superadmin only writes) ─────────────────────────────────
    match /app_config/{configId} {
      // Allow startup update checks before authentication for this single doc.
      allow read: if configId == 'update_checker' || isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── ROUTE CACHE (per-user) ──────────────────────────────────────────────
    // Searches can show where someone travels: owner only. (The app keeps
    // its route cache on the phone now; nothing reads this collection.)
    match /route_cache/{cacheId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
