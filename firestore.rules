rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'superadmin';
    }

    // FIX: Use .get('role', '') to safely handle missing role field,
    // preventing null-dereference crashes in rule evaluation.
    function isModerator() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'moderator';
    }

    function isStaff() {
      return isModerator() || isSuperAdmin();
    }

    function hasValidPostContent(data) {
      return data.content is string &&
        data.content.size() > 0 &&
        data.content.size() <= 500;
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /achievements/{achievementId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /badges/{badgeId} {
        allow read, write: if isSelf(uid) || isStaff();
      }

      match /routeHistory/{historyId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── POSTS ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // FIX: Pending posts are now only visible to their own author.
      allow read: if isAuth() && (
        isStaff() ||
        resource.data.moderationStatus == 'approved' ||
        (resource.data.moderationStatus == 'pending' &&
          request.auth.uid == resource.data.userId)
      );

      allow create: if isAuth() && hasValidPostContent(request.resource.data);

      // FIX: Added field-level validation for post votes.
      // Vote counters can only move by 1 per operation and voter arrays
      // are constrained to transitions involving the requesting UID.
      allow update: if isAuth() &&
        hasValidPostContent(request.resource.data) && (
          request.auth.uid == resource.data.userId ||
          isStaff() ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['upvoteCount', 'downvoteCount', 'upvotedBy', 'downvotedBy']) &&
            request.resource.data.upvoteCount >= 0 &&
            request.resource.data.downvoteCount >= 0 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) >= -1 &&
            (request.resource.data.upvoteCount - resource.data.upvoteCount) <= 1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) >= -1 &&
            (request.resource.data.downvoteCount - resource.data.downvoteCount) <= 1 &&
            (
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount &&
                request.resource.data.upvotedBy == resource.data.upvotedBy
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount + 1 &&
                request.resource.data.upvotedBy.hasAll(resource.data.upvotedBy) &&
                request.resource.data.upvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.upvoteCount == resource.data.upvoteCount - 1 &&
                !request.resource.data.upvotedBy.hasAny([request.auth.uid])
              )
            ) &&
            (
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount &&
                request.resource.data.downvotedBy == resource.data.downvotedBy
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount + 1 &&
                request.resource.data.downvotedBy.hasAll(resource.data.downvotedBy) &&
                request.resource.data.downvotedBy.hasAll([request.auth.uid])
              ) ||
              (
                request.resource.data.downvoteCount == resource.data.downvoteCount - 1 &&
                !request.resource.data.downvotedBy.hasAny([request.auth.uid])
              )
            )
          )
        );

      allow delete: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        isStaff()
      );

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() &&
          resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isStaff()
        );
      }
    }

    // ── ROUTES ────────────────────────────────────────────────────────────────
    match /routes/{routeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.contributorId == request.auth.uid ||
        isStaff() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'upvotes', 'downvotes', 'updatedAt']) &&
          request.resource.data.views >= 0 &&
          request.resource.data.upvotes >= 0 &&
          request.resource.data.downvotes >= 0 &&
          (request.resource.data.views - resource.data.views) >= -1 &&
          (request.resource.data.views - resource.data.views) <= 1 &&
          (request.resource.data.upvotes - resource.data.upvotes) >= -1 &&
          (request.resource.data.upvotes - resource.data.upvotes) <= 1 &&
          (request.resource.data.downvotes - resource.data.downvotes) >= -1 &&
          (request.resource.data.downvotes - resource.data.downvotes) <= 1
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['feedbackSummary', 'updatedAt'])
        )
      );
      allow delete: if isStaff();

      // Per-user vote state for one active vote at a time.
      match /routeVotes/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }

      // Per-user view markers to avoid recounting the same user repeatedly.
      match /routeViews/{userId} {
        allow read, create, update, delete: if isAuth() && isSelf(userId);
      }

      // Per-user trust feedback answers for route reliability.
      match /routeFeedback/{userId} {
        allow read: if isAuth() && isSelf(userId);
        allow create: if isAuth() && isSelf(userId);
        allow update: if isAuth() && isSelf(userId);
        allow delete: if false;
      }

      // Route audit logs are visible to staff; regular users can only write
      // self-authored commuter feedback log entries.
      match /auditLogs/{logId} {
        allow read: if isStaff();
        allow create: if isAuth() && (
          isStaff() ||
          (
            request.resource.data.action == 'commuter_feedback_submitted' &&
            request.resource.data.actorId == request.auth.uid
          )
        );
        allow update, delete: if isStaff();
      }
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isAuth() &&
        resource.data.userId == request.auth.uid;

      // FIX: Moderators can create notifications for any userId, including
      // themselves (e.g. self-approval of a submitted route). Non-moderators
      // still cannot target themselves to prevent self-spam.
      allow create: if isAuth() && (
        isModerator() ||
        isSuperAdmin() ||
        (
          request.resource.data.keys().hasAll(['userId', 'type', 'timestamp']) &&
          request.resource.data.userId is string &&
          request.resource.data.userId != request.auth.uid
        )
      );
    }

    // ── FEEDBACKS (reports) ───────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow create: if isAuth();
      // FIX: Users can now read their own feedback to see its status.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isStaff()
      );
      allow update, delete: if isStaff();
    }

    // ── LOCATIONS ─────────────────────────────────────────────────────────────
    match /locations/{locationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // FIX: Restricted update/delete to creator or moderator only.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
    }

    // ── ANNOUNCEMENTS (superadmin only writes) ──────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── APP CONFIG (superadmin only writes) ─────────────────────────────────
    match /app_config/{configId} {
      // Allow startup update checks before authentication for this single doc.
      allow read: if configId == 'update_checker' || isAuth();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
